# Configure only in server-side Secrets. Never prefix private keys with VITE_.
APLUS_APP_ORIGIN=https://your-staging-project.lovable.app
APLUS_STATE_INSTANCE=academy-staging
APLUS_STATE_KEY=<64 hex characters generated privately>
APLUS_CSRF_KEY=<server-only random value, 32+ characters>
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-side secret>
APLUS_DEPLOYMENT_STAGE=staging
# Real migration and production release remain disabled until rehearsal and approval.
APLUS_RELEASE_APPROVED=false
